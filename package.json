{
  "name": "yingqi-agent-lab",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "next build --webpack",
    "dev:vercel": "next dev",
    "start:vercel": "next start",
    "test": "tsx --test tests/*.test.ts",
    "evidence:workbenches": "tsx scripts/workbench-evidence.ts",
    "eval:finpilot:ablation": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/finpilot-ablation.ts",
    "eval:finpilot:smoke": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/finpilot-ablation.ts --offline-smoke",
    "evidence:careflow": "tsx scripts/careflow-evidence.ts",
    "eval:careflow:live": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/careflow-live-eval.ts",
    "market:cn:download": "python scripts/cn-universe-backtest.py download",
    "market:cn:evaluate": "python scripts/cn-universe-backtest.py evaluate",
    "lint": "oxlint app lib tests",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.4.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260904.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
